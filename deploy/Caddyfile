# Sound Crystals — production web server. Runs in a Caddy container on the
# exe.dev VM. exe.dev terminates TLS at its proxy, so plain HTTP on :80.
{
	admin off
	auto_https off
}

:80 {
	root * /srv/site

	# iterating experiment, no fingerprinting: never serve a stale build.
	# no-cache = revalidate every request; Caddy answers unchanged files with
	# cheap 304s (ETag/Last-Modified), and the heavy deps come from CDNs anyway.
	header Cache-Control "no-cache"

	encode gzip zstd

	try_files {path} {path}/ /index.html
	file_server
}
