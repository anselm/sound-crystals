# Sound Crystals — production web server. Runs in a Caddy container on the
# exe.dev VM. exe.dev terminates TLS at its proxy, so plain HTTP on :80.
{
	admin off
	auto_https off
}

:80 {
	root * /srv/site

	# no build step / no fingerprinting — cache modestly
	@assets path *.js *.css *.png *.ico
	header @assets Cache-Control "public, max-age=3600"

	encode gzip zstd

	try_files {path} {path}/ /index.html
	file_server
}
